{
  "name": "dev-digest-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog": "python3 ../scripts/build_catalog.py",
    "embed": "node scripts/embed.mjs",
    "data": "npm run catalog && npm run embed",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
