{
  "description": "Rebase onto origin/<default> before every git commit",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rebase-before-commit.mjs\"",
            "timeout": 60,
            "statusMessage": "Rebasing onto origin/main"
          }
        ]
      }
    ]
  }
}
